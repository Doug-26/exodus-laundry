# ── Secrets — never commit ───────────────────────────────────────────────────
.env
.env.local
.env.*.local

# Generated Firebase environment files (created from .env by scripts/generate-env.mjs).
# The committed *.example.ts templates are the reference; the real ones stay local.
apps/*/src/environments/environment.ts
apps/*/src/environments/environment.prod.ts

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ── Build outputs ────────────────────────────────────────────────────────────
dist/
www/
functions/lib/
.angular/
coverage/

# ── Firebase ─────────────────────────────────────────────────────────────────
.firebase/
*-debug.log
firebase-debug.log*
firestore-debug.log*
database-debug.log*
ui-debug.log*

# ── Capacitor native projects ────────────────────────────────────────────────
# android/ IS committed (CI builds the signed release APK from it). Build outputs,
# local.properties, keystores and google-services.json are excluded by
# apps/mobile/android/.gitignore. iOS isn't used in this project.
/apps/mobile/ios/

# ── Signing / service-account secrets — never commit ─────────────────────────
*.jks
*.keystore
**/google-services.json
**/GoogleService-Info.plist
service-account*.json
# Firebase service-account / admin-SDK private keys (never commit — use GitHub secrets)
*-adminsdk-*.json
*serviceAccount*.json
# base64 secret dumps (keystore / google-services encodings)
*.b64

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ──────────────────────────────────────────────────────────────────────
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

rules_version = '2';

// Exodus Laundry — Cloud Storage rules.
//
// IMPORTANT: Storage rules CANNOT read Firestore, so there is no roleIs() /
// isStaff() equivalent here (contrast firestore.rules, which gates on the
// users/{uid}.role document). Everything below is gated by path ownership only.
// Role-gated paths (staff proof photos) arrive in Phase 14, which introduces a
// `role` custom claim readable here as request.auth.token.role.

service firebase.storage {
  match /b/{bucket}/o {

    // Customer avatars — one object per user at avatars/{uid}/avatar.jpg,
    // overwritten on every change so no orphans accumulate.
    //
    // Readable by anyone holding the download URL: the URL carries an
    // unguessable token, and staff need to render customer avatars without a
    // role check being possible here.
    match /avatars/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource != null
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Deny everything else, including any path a future feature adds before its
    // rules are written.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

{
  "name": "exodus-laundry",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "config": "node scripts/generate-env.mjs",
    "seed:admin": "node scripts/seed-admin.mjs",
    "test:shared": "jest --config libs/shared/jest.config.js",
    "test:rules": "firebase emulators:exec --only firestore --project exodus-rules-test \"jest --config rules-tests/jest.config.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "~5.8.0"
  }
}

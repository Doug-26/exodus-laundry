/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* @angular/google-maps references the google.maps global namespace (Phase 15).
       With "types": [] no global type packages are loaded, so it must be named
       explicitly — same arrangement as apps/mobile/tsconfig.app.json. */
    "types": ["google.maps"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts"]
}

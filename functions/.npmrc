# The monorepo root sets legacy-peer-deps=true (for the Angular/typescript-eslint
# peer conflict). Functions has no such conflict, and legacy-peer-deps suppresses
# firebase-admin's transitive peer @firebase/app — which the Cloud Functions
# runtime needs (firebase-functions eagerly loads its RTDB provider). Force the
# normal peer resolution here so the deployed node_modules is complete.
legacy-peer-deps=false

# Firebase configuration — copy this file to .env and fill in the values.
# Get these values from: Firebase Console → Project Settings → Your apps → Web app config.
#
# NEVER commit .env to git. It is listed in .gitignore.

# ── Shared by both the mobile app and the dashboard ─────────────────────────
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ── Mobile app (Capacitor) ───────────────────────────────────────────────────
# FCM Sender ID for push notifications (same as MESSAGING_SENDER_ID above but
# also needs to be in google-services.json / GoogleService-Info.plist)
FIREBASE_MEASUREMENT_ID=

# ── Realtime Database ────────────────────────────────────────────────────────
# Used for live rider location streaming (deliveries/{orderId}/riderLocation)
FIREBASE_DATABASE_URL=

# ── Google Maps ─────────────────────────────────────────────────────────────
# Required for @capacitor/google-maps (in-app maps + Routes API).
# Billing account must be attached even for the free tier.
# Restrict this key to your app's bundle ID / package name + Maps SDK + Routes API.
GOOGLE_MAPS_API_KEY=

# Dashboard delivery map (Phase 15). MUST be a SEPARATE key from the one above:
# Google Cloud allows only one restriction type per key, so an Android-restricted
# key cannot work in a browser. This one ships inside the public dashboard bundle,
# so restrict it to HTTP referrers — exodus-laundry.web.app/*,
# exodus-laundry.firebaseapp.com/*, localhost:4200/* — and to the Maps JavaScript
# API only. An unrestricted browser key is a billing risk.
GOOGLE_MAPS_BROWSER_KEY=
